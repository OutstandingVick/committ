# The ClawPump API key for the ClawPump agent this bridge runs as.
# Get this from https://agents.clawpump.tech/dashboard/api
# Format: cpk_...
CLAWPUMP_API_KEY=

# A long random string you generate yourself (e.g. `openssl rand -hex 32`).
# The Committ web app must send this back on every request as:
#   Authorization: Bearer <BRIDGE_SHARED_SECRET>
# Anyone who has this value can spend this bridge's ClawPump agent, so treat
# it like a password. Never commit the real value.
BRIDGE_SHARED_SECRET=

# Port the HTTP server listens on. Most hosts (Render, Railway, Fly.io)
# inject PORT for you; only set this for local development.
PORT=8787
